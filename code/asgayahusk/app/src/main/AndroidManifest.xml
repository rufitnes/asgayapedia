<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package visibility for Android 11+ to check bank app health -->
    <queries>
        <package android:name="com.rsi.nba" />
        <package android:name="com.bbva.bbvacontigo" />
        <package android:name="es.bancosantander.apps" />
        <package android:name="es.bancsabadell.mobilebancohd" />
        <package android:name="net.inverline.bancosabadell.officelocator.android" />
        <package android:name="es.ingdirect.ing" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Asgaya"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tab 2: Remittances -->
        <activity
            android:name=".remittance.RemittanceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".remittance.SendRemittanceActivity"
            android:exported="false"
            android:parentActivityName=".remittance.RemittanceActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tab 3: Trade (Merchant Cashout) -->
        <activity
            android:name=".trade.TradeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".trade.MerchantVerificationActivity"
            android:exported="false"
            android:parentActivityName=".trade.TradeActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".trade.CashoutSuccessActivity"
            android:exported="false"
            android:parentActivityName=".trade.TradeActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".trade.PublishListingActivity"
            android:exported="false"
            android:parentActivityName=".trade.TradeActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".trade.MyAdsActivity"
            android:exported="false"
            android:parentActivityName=".trade.TradeActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".trade.MarketActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".remittance.ReviewSendActivity"
            android:exported="false"
            android:parentActivityName=".remittance.SendRemittanceActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".send.SendActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ClaimActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ContactsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".NotificationListener"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitoring Bizum payment notifications for cryptocurrency exchange" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Fires at a funded covenant's expiry to trigger the seller's buffer recovery -->
        <receiver
            android:name=".CovenantExpiryReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>