<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:titleTextColor="?attr/colorOnPrimary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/identityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingBottom="16dp"
                android:text="—" />

            <!-- 1 · Ad type -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1 · What are you advertising?"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:paddingBottom="4dp" />

            <RadioGroup
                android:id="@+id/adTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/typeSeller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Sell BCH for EUR" />

                <RadioButton
                    android:id="@+id/typeBuyer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sell EUR for BCH" />
            </RadioGroup>

            <!-- 2 · Asset (the non-BCH side) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 · Asset (the non-BCH side)"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:paddingBottom="4dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/assetChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/assetEur"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="EUR" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/assetUsd"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USD" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/assetVes"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VES" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/assetHeur"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H€" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/assetHau"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HAu" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/assetOtherChip"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other…" />
            </com.google.android.material.chip.ChipGroup>

            <EditText
                android:id="@+id/assetOtherInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:hint="Other asset (e.g. rice, milk, a token)"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <!-- 3 · Payment method -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 · Payment method (how the fiat moves)"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:paddingBottom="4dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/methodChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:chipSpacingHorizontal="8dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/methodCash"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Cash in person" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/methodCard"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card in person" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/methodBizum"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bizum" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/methodSepa"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEPA" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/methodPagoMovil"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PagoMóvil" />
            </com.google.android.material.chip.ChipGroup>

            <!-- 4 · Fee — the ad's rate margin (editable; may be negative, `bulletin-board/20`) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4 · Fee"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/feeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fee % (0.5 = 0.5%; may be negative)"
                android:inputType="numberDecimal|numberSigned"
                android:layout_marginBottom="16dp" />

            <!-- 5 · Buffer (fixed for now) — only for the BCH-selling side (`09 §10`) -->
            <LinearLayout
                android:id="@+id/bufferSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5 · Volatility buffer"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/bufferValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="7% · fixed for now"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- 6 · Limits -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6 · Limits"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/minInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Min"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/maxInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Max"
                    android:inputType="numberDecimal"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- ───────── divider: the public ad above · the payment instructions below ───────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33808080"
                android:layout_marginBottom="16dp" />

            <!-- Payment instructions — completed here (same place as the ad). Stored per ad;
                 served to the counterparty in the [PAY_INSTRUCTIONS] DM; never in the public listing. -->
            <LinearLayout
                android:id="@+id/instructionsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/instrNameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Name / establishment name"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/instrNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/instrAddressLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Address"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/locationInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/instrHoursLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Opening hours"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hoursInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/instrPhoneLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Bizum phone"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/instrPhoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Payment instructions"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This text is sent with the payment instructions to the user who selects your ad on the bulletin board."
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/instrNotesLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Notes / extra instructions (optional)"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/notesInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/instrIbanLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="SEPA IBAN"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/instrIbanInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/publishButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="💾 Save ad" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
