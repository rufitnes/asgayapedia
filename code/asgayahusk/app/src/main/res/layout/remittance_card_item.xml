<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Status badge and timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Status Badge -->
            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Pending"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF6F00"
                android:background="#FFF3E0"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 hours ago"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Recipient -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="To:"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/recipientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elena #142"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="2dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Amount Section (for sent remittances) -->
        <LinearLayout
            android:id="@+id/amountSectionSent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- You Sent -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You sent"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/amountSent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="€10.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/amountSentBch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00153846 BCH"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textSize="24sp"
                android:textColor="?attr/colorPrimary"
                android:layout_gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- They Get -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="They get"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/amountReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8,600 Bs"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Amount Section (for received covenants) -->
        <LinearLayout
            android:id="@+id/amountSectionReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/receivedAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Someone sent you 5,00 €"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center" />

            <TextView
                android:id="@+id/receivedAmountBch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="balance: 0.00769231 BCH"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Transaction ID (only if confirmed) -->
        <TextView
            android:id="@+id/txidLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaction ID:"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="abc123...def456"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <!-- Covenant Status -->
        <TextView
            android:id="@+id/covenantStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Covenant Status:"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/covenantStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap 🔄 to check"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <!-- Countdown Timer (for received covenants) -->
        <TextView
            android:id="@+id/covenantCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ 2h 15m until expires"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareParamsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️ Resend to recipient"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkBalanceButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Check Status"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/claimMerchantButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claim at merchant"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refundButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↩️ Refund"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendAgainButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔁 Send again"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
