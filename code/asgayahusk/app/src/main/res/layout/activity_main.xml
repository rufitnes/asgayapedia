<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".MainActivity">

    <!-- Header: title + (standard) wallet name + icons -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Asgaya"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- STANDARD only: wallet NAME (tap to switch). Hidden in Advanced (`ui-rethink/12`) -->
    <TextView
        android:id="@+id/walletName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💼 Sender ▼"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:padding="8dp"
        android:layout_marginStart="2dp"
        app:layout_constraintTop_toTopOf="@id/appTitle"
        app:layout_constraintBottom_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toEndOf="@id/appTitle"
        tools:text="💼 Sender ▼" />

    <ImageView
        android:id="@+id/contactsIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_my_calendar"
        android:contentDescription="Test Wallets"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/settingsIcon"
        android:layout_marginEnd="4dp" />

    <ImageView
        android:id="@+id/settingsIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="Settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp" />

    <!-- Balance container (holds BOTH variants; exactly one visible) -->
    <LinearLayout
        android:id="@+id/balanceContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- STANDARD: balance, discrete single line -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/balanceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wallet balance"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAlignment="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/balanceFiat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="≈ €0.00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="≈ €52.34" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  ·  "
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/balanceBch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00000000 BCH"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="0.05234000 BCH" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ADVANCED: the previous hero balance (role label + big BCH) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/balanceCardAdv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/walletRoleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏦 SELLER"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp"
                    tools:text="💼 SENDER" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Your Balance"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/balanceBchAdv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 BCH"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="0.15 BCH" />

                <TextView
                    android:id="@+id/balanceFiatAdv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="≈ €0.00"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp"
                    tools:text="≈ €100.00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- The hero: Send / Receive (shared) -->
    <Button
        android:id="@+id/sendMoneyButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:text="📤 Send"
        android:textSize="18sp"
        style="@style/Widget.Material3.Button"
        app:layout_constraintTop_toBottomOf="@id/balanceContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/receiveMoneyButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:text="📥 Receive"
        android:textSize="18sp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:layout_constraintTop_toBottomOf="@id/sendMoneyButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Activity / History — the contextual entry to the Activity screen (`ui-rethink/41`) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/activityHistoryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="📜 History"
        android:textSize="14sp"
        style="@style/Widget.Material3.Button.TextButton"
        app:layout_constraintTop_toBottomOf="@id/receiveMoneyButton"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- STANDARD: active-covenant chips (max 2), tap → Activity (`ui-rethink/12`) -->
    <LinearLayout
        android:id="@+id/activeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/activityHistoryButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pending Covenant Card (conditionally visible) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pendingCovenantCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:layout_constraintTop_toBottomOf="@id/activeContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📥 Money Waiting"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/covenantSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From: María"
                android:textSize="14sp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:layout_marginBottom="8dp"
                tools:text="From: María" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount:"
                android:textSize="12sp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/covenantAmountBch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.15 BCH"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:layout_marginTop="4dp"
                tools:text="0.15 BCH" />

            <TextView
                android:id="@+id/covenantAmountFiat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="≈ €100.00"
                android:textSize="14sp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:layout_marginBottom="12dp"
                tools:text="≈ €100.00" />

            <TextView
                android:id="@+id/covenantExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ Expires in 5h 23m"
                android:textSize="12sp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:layout_marginBottom="16dp"
                tools:text="⏰ Expires in 5h 23m" />

            <Button
                android:id="@+id/claimButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Claim Now"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.Button.ElevatedButton" />

            <Button
                android:id="@+id/cashOutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cash Out at Merchant"
                android:textSize="14sp"
                android:enabled="false"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Empty state (shared) -->
    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nothing active yet.\n\nSend money to get started →"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAlignment="center"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/pendingCovenantCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <!-- ADVANCED only: the previous "Transaction History — coming soon" card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/historyCardAdv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/emptyStateText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Transaction History"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coming soon..."
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_navigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
