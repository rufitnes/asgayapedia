<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:elevation="4dp"
            app:titleTextColor="?attr/colorOnPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Customer Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/customerDetailsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Details"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/customerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From: Elena"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="4dp"
                    tools:text="From: Elena" />

                <TextView
                    android:id="@+id/cashToPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cash to pay: €100.00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="8dp"
                    tools:text="Cash to pay: €100.00" />

                <TextView
                    android:id="@+id/bchToReceive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BCH to receive: 0.154 BCH"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp"
                    tools:text="BCH to receive: 0.154 BCH" />

                <TextView
                    android:id="@+id/covenantAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Covenant: bchtest:pv...7a3b"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="8dp"
                    tools:text="Covenant: bchtest:pvel3w...7n0qva46s" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Verification Section Header -->
        <TextView
            android:id="@+id/verificationHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Verification Checklist"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/customerDetailsCard"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Verification Progress -->
        <ProgressBar
            android:id="@+id/verificationProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/verificationHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Verification Checklist Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/verificationChecklist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/verificationHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/checkUtxoExists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ UTXO exists on-chain"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    tools:text="✅ UTXO exists on-chain" />

                <TextView
                    android:id="@+id/checkUtxoUnspent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ UTXO is unspent"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    tools:text="✅ UTXO is unspent" />

                <TextView
                    android:id="@+id/checkAmountCorrect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Amount correct"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    tools:text="✅ Amount correct" />

                <TextView
                    android:id="@+id/checkNotExpired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Not expired (6h 23m left)"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    tools:text="✅ Not expired (6h 23m left)" />

                <TextView
                    android:id="@+id/checkPriceOk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price check"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    tools:text="✅ Price OK" />

                <TextView
                    android:id="@+id/checkOracleSigValid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Oracle signature valid"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    tools:text="✅ Oracle signature valid" />

                <TextView
                    android:id="@+id/checkOracleFresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Oracle fresh (45s old)"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    tools:text="✅ Oracle fresh (45s old)" />

                <TextView
                    android:id="@+id/checkOutputMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Output 0 = my address"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="✅ Output 0 = my address" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Important Process Warning -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/warningCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFF9C4"
            app:layout_constraintTop_toBottomOf="@id/verificationChecklist"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️  Important Process:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Tap &quot;Sign &amp; Broadcast&quot;\n2. Wait for confirmation\n3. THEN give cash to customer"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/warningCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <Button
                android:id="@+id/signAndBroadcastButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sign &amp; Broadcast"
                android:layout_marginStart="8dp"
                style="@style/Widget.Material3.Button" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
